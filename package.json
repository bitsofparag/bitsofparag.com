{
  "version": "3.4.2",
  "author": "Parag M. <admin@bitsofparag.com>",
  "main": "index.js",
  "dependencies": {
    "tailwindcss": "^3.3.1"
  },
  "description": "Personal website of Parag Majumdar",
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^4.1.0",
    "@types/glob": "^8.1.0",
    "autoprefixer": "^10.0.2",
    "cheerio": "^1.0.0-rc.12",
    "cssnano": "^6.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.33.0",
    "postcss": ">=8.3.3 <9.0.0",
    "postcss-cli": ">= 8.0",
    "postcss-import": "^15.1.0",
    "postcss-load-config": ">= 3.0",
    "postcss-modules": "^5.0.0",
    "postcss-syntax": "^0.36.2",
    "postcss-url": "^10.1.3",
    "rimraf": "^3.0.2",
    "wrangler": "^4.129.0"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "parag",
    "blog",
    "opinion",
    "technology",
    "experiments",
    "code",
    "social",
    "travel",
    "inspiration"
  ],
  "license": "ISC",
  "private": true,
  "name": "bitsofparag.com",
  "repository": {
    "type": "git",
    "url": "git@gitlab.com:parag_m/bitsofparag.com.git"
  },
  "scripts": {
    "clean:misc": "find . -name \"*.*~\" | xargs rm -rf",
    "clean:dist": "rimraf dist",
    "clean": "npm run clean:misc && npm run clean:dist",
    "lint": "eslint ./site-assets/scripts/** --ignore ./site-assets/styles/**/*.* && stylelint ./site-assets/styles/**",
    "test": "node --test",
    "build:org": "mkdir -p .org-timestamps && emacs --batch --load publish.el --eval '(setq org-publish-timestamp-directory \"./.org-timestamps/\")' --eval '(org-publish-remove-all-timestamps)' --eval '(org-publish \"website\")' $EXTRA_EMACS_ARGS",
    "build:rss": "mkdir -p .org-timestamps && emacs --batch --load publish.el --eval '(setq org-publish-timestamp-directory \"./.org-timestamps/\")' --eval '(org-publish-remove-all-timestamps)' --eval '(org-publish \"rss\")' $EXTRA_EMACS_ARGS",
    "build:css": "postcss site-assets/styles/index.css -o dist/static/styles/index.css",
    "build:js": "esbuild site-assets/scripts/index.js --bundle --outdir=dist/static/scripts --sourcemap --target=es2017",
    "build:js:prod": "esbuild site-assets/scripts/index.js --bundle --outdir=dist/static/scripts --minify --target=es2017",
    "build": "npm run build:org && npm run build:rss && npm run build:css && npm run build:js",
    "optimize": "just optimize-images",
    "dist": "npm run clean && npm run build:org && npm run build:rss && npm run build:css && npm run build:js:prod && npm run optimize"
  }
}
